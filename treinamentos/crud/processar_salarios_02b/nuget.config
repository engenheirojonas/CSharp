<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
	<add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
	<add key="mysql" value="I:\Repositorios\CSharp\Xtools\PacotesNugetLocal\SGBD" allowInsecureConnections="true" />
  </packageSources>
  <packageSourceMapping>
	<packageSource key="nuget.org">
	  <package pattern="*" />
	</packageSource>
	<packageSource key="mysql">
	  <package pattern="MySql.*" />
	  <package pattern="Local*" />
	</packageSource>
  </packageSourceMapping>
</configuration>
